<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HalliSantheDigital">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HalliSantheDigital">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.BuyerHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.SellerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.addproduct.AddProductActivity"
            android:exported="false" />

        <activity
            android:name=".ui.productdetail.ProductDetailActivity"
            android:exported="false" />

        <!-- ✅ Auth Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false" />

        <!-- ✅ Profile Activity -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

    </application>

</manifest>